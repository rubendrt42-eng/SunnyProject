# Public site URL (used to build absolute links in emails and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project credentials. Both NEXT_PUBLIC_* values are safe to expose
# to the browser (used by the client-side Supabase client for auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose this to the browser or commit it — it bypasses
# Row Level Security entirely. Used for: the ADMIN_EMAIL role bootstrap,
# Supabase Storage image uploads' public URL resolution helpers, and admin
# actions that need auth.users data (emails for CSV export / notifications).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Resend API key for transactional emails. If empty in
# development, emails are logged to the console instead of sent — the app
# still works fully without it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sunny Project <onboarding@resend.dev>

# Server-only. The email that gets promoted to the "admin" role on first
# login (see PRODUCT_SPEC.md §6). Must match exactly (case-insensitive).
ADMIN_EMAIL=

# Optional, only used by tests/integration/reservations.test.ts. Point these
# at a DISPOSABLE Supabase test project — never production. Leave empty to
# skip the live-database integration suite (unit tests still run).
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
