# ─────────────────────────────────────────────────────────────────────────────
# The Sunny Project — MVP Lean
#
# Copia este archivo como `.env.local` para desarrollo, y carga las mismas
# variables en Vercel para el despliegue.
#
# NUNCA pongas valores reales en este archivo: está versionado en Git.
#
# Instrucciones paso a paso para conseguir cada valor: MVP_SETUP.md
# ─────────────────────────────────────────────────────────────────────────────


# ── Sanity: el contenido del sitio ───────────────────────────────────────────
#
# Ni el id de proyecto ni el dataset son secretos: viajan en cada petición que
# el navegador hace a Sanity. Por eso llevan el prefijo NEXT_PUBLIC_.
# Ya están configurados: solo hace falta cambiarlos si se apunta a otro dataset.

NEXT_PUBLIC_SANITY_PROJECT_ID=gp6ztiei
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01


# ── Google Sheets: donde caen las solicitudes ────────────────────────────────
#
# SECRETO. Estas tres nunca llevan NEXT_PUBLIC_ y nunca deben llegar al
# navegador. Son de una cuenta de servicio con acceso a UNA hoja, no a tu
# cuenta de Google entera.
#
# GOOGLE_PRIVATE_KEY es multilínea. Al pegarla en Vercel, los saltos de línea
# se guardan como \n literal; el código ya lo tiene en cuenta y los convierte.
# Pégala tal cual te la dé Google, con las líneas -----BEGIN/END----- incluidas.

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=


# ── Correo: avisos de solicitud ──────────────────────────────────────────────
#
# SECRETO (la API key).
#
# Llevan prefijo MVP_ a propósito, para que este flujo no pueda heredar por
# accidente la configuración de la versión avanzada del proyecto.
#
# MVP_EMAIL_FROM tiene que ser una dirección de un dominio verificado en
# Resend. Sin dominio verificado, los correos solo llegan a la cuenta dueña.
# MVP_NOTIFY_EMAIL es la bandeja de Emmy: ahí caen los avisos de solicitud.

MVP_RESEND_API_KEY=
MVP_EMAIL_FROM=
MVP_NOTIFY_EMAIL=


# ── El sitio ─────────────────────────────────────────────────────────────────
#
# La dirección pública, sin barra al final. Se usa para armar enlaces
# absolutos. En Vercel puede ser la URL del proyecto hasta que haya dominio.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
